# Copy to `.env` and fill in. Only the scraper needs these — the website does not.

# The FULL tokened auctions URL, copied from your browser after you open the
# MOJ auctions portal. This is the whole address including ?token=…
# Example:
# MOJ_AUCTIONS_URL=https://auctions.moj.gov.jo/AuctionsList.aspx?token=XXXXXXXX
MOJ_AUCTIONS_URL=

# --- optional tuning ---
# SCRAPE_IMAGES=1          # set 0 to scrape data only (fast, no media)
# SCRAPE_REPORT=1          # set 0 to skip the heavy تقرير الخبرة report scans
# SCRAPE_MAX_PAGES=        # cap pages while testing, e.g. 2
# HEADLESS=1               # set 0 to watch the browser while it runs
#
# The scraper captures all three detail tabs per auction:
#   الصور (car photos) · تقرير الخبرة (expert report) · الاعلان (sale notice)
# saved under public/car-images/<id>/{photos,report,announcement}/.
