{
  "name": "moj-auctions",
  "version": "1.0.0",
  "private": true,
  "description": "Fast, modern mirror of the Jordanian MOJ electronic vehicle auctions (المزادات الإلكترونية) — a snapshot-driven Next.js site plus a Playwright scraper.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
