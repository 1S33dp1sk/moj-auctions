    "postinstall": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "10.4.19",
    "playwright": "1.45.3",
    "postcss": "8.4.39",
    "sharp": "0.33.4",
    "tailwindcss": "3.4.7"
  }
}
